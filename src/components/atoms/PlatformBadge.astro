---
// Atom — platform icon + name + subscriber count for client cards
interface Props {
  platform: 'tiktok' | 'twitch' | 'youtube'
  subscribers: string
}

const { platform, subscribers } = Astro.props

const meta: Record<string, { label: string; countClass: string }> = {
  tiktok:  { label: 'Tiktok',  countClass: 'text-cyan-400' },
  twitch:  { label: 'Twitch',  countClass: 'text-purple-400' },
  youtube: { label: 'YouTube', countClass: 'text-red-400' },
}

const { label, countClass } = meta[platform]
---

<div class="flex items-center gap-1.5">
  {platform === 'tiktok' && (
    <svg class="h-3.5 w-3.5 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.66a8.27 8.27 0 004.84 1.55V6.76a4.85 4.85 0 01-1.07-.07z"/>
    </svg>
  )}
  {platform === 'twitch' && (
    <svg class="h-3.5 w-3.5 text-purple-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/>
    </svg>
  )}
  {platform === 'youtube' && (
    <svg class="h-3.5 w-3.5 text-red-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
    </svg>
  )}
  <span class="text-xs font-medium text-white/70">{label}</span>
  <span class={`text-xs font-bold ${countClass}`}>{subscribers} suscriptores</span>
</div>
