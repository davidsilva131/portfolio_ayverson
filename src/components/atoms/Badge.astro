---
// Atom — reusable pill badge
interface Props {
  label: string
  size?: 'sm' | 'md'
  dataI18n?: string
}

const { label, size = 'md', dataI18n } = Astro.props

const sizes = {
  sm: 'px-3 py-1 text-xs gap-1.5',
  md: 'px-4 py-1.5 text-sm gap-2',
}
---

<span
  class={`inline-flex items-center rounded-full border border-white/10 bg-white/5 font-medium text-white/80 backdrop-blur-sm ${sizes[size]}`}
>
  <span data-i18n={dataI18n}>{label}</span>
</span>
