---
const STAR_COUNT = 60
const stars = Array.from({ length: STAR_COUNT }, () => ({
  top: Math.random() * 100,
  left: Math.random() * 100,
  size: 1 + Math.random() * 2.5,
  drift: Math.ceil(Math.random() * 4),
  duration: 20 + Math.random() * 40,
  delay: Math.random() * 20,
}))
---

<div id="starfield" aria-hidden="true" style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none;overflow:hidden;">
  {stars.map((s) => (
    <span
      class={"star drift-" + s.drift}
      style={{
        top: s.top + "%",
        left: s.left + "%",
        width: s.size + "px",
        height: s.size + "px",
        animationDuration: s.duration + "s",
        animationDelay: s.delay + "s",
      }}
    ></span>
  ))}
</div>

<style is:global>
  .star {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 2px rgba(255, 255, 255, 0.7), 0 0 6px rgba(255, 255, 255, 0.25);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    will-change: transform, opacity;
  }
  .drift-1 { animation-name: drift-1; }
  .drift-2 { animation-name: drift-2; }
  .drift-3 { animation-name: drift-3; }
  .drift-4 { animation-name: drift-4; }

  @media (prefers-reduced-motion: reduce) {
    .star {
      animation: none;
      opacity: 0.5;
    }
  }

  @keyframes drift-1 {
    0%, 100% { transform: translate(0, 0);    opacity: 0.3; }
    33%       { transform: translate(8px, -12px); opacity: 0.7; }
    66%       { transform: translate(-4px, -6px); opacity: 0.5; }
  }
  @keyframes drift-2 {
    0%, 100% { transform: translate(0, 0);     opacity: 0.5; }
    33%       { transform: translate(-10px, -8px); opacity: 0.85; }
    66%       { transform: translate(-3px, -14px); opacity: 0.4; }
  }
  @keyframes drift-3 {
    0%, 100% { transform: translate(0, 0);     opacity: 0.4; }
    33%       { transform: translate(-7px, -15px); opacity: 0.7; }
    66%       { transform: translate(5px, -5px);  opacity: 0.6; }
  }
  @keyframes drift-4 {
    0%, 100% { transform: translate(0, 0);     opacity: 0.55; }
    33%       { transform: translate(12px, -4px);  opacity: 0.3; }
    66%       { transform: translate(6px, -10px);  opacity: 0.9; }
  }
</style>
