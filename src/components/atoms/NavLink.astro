---
// Atom — single navigation anchor with animated underline
interface Props {
  href: string
  label: string
  isButton?: boolean
}

const { href, label, isButton = false } = Astro.props
---

{isButton ? (
  <a
    href={href}
    class="relative inline-flex items-center gap-1.5 rounded-full border border-violet-500/60 bg-violet-600/10 px-5 py-2 text-sm font-semibold tracking-wide text-violet-300 transition-all duration-300 hover:bg-violet-500/25 hover:text-white hover:border-violet-400 hover:shadow-[0_0_18px_rgba(139,92,246,0.4)]"
  >
    {label}
  </a>
) : (
  <a
    href={href}
    class="group relative text-sm font-medium tracking-widest text-white/60 uppercase transition-colors duration-300 hover:text-white"
  >
    {label}
    <span
      class="absolute -bottom-0.5 left-0 h-px w-0 bg-linear-to-r from-violet-500 to-cyan-400 transition-all duration-300 group-hover:w-full"
    ></span>
  </a>
)}
