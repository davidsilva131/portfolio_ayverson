---
// Atom — gold star rating display with label
interface Props {
  rating?: number
  max?: number
  label?: string
}

const { rating = 5, max = 5, label = 'Reseñas 5/5' } = Astro.props
const stars = Array.from({ length: max }, (_, i) => i < rating)
---

<div class="flex items-center gap-2">
  <div class="flex items-center gap-0.5" aria-label={`${rating} de ${max} estrellas`}>
    {stars.map((filled) => (
      <svg
        class={`h-4 w-4 ${filled ? 'text-amber-400' : 'text-white/20'}`}
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>
  <span class="text-sm font-semibold text-amber-400/90" data-i18n="stars.label">{label}</span>
</div>
