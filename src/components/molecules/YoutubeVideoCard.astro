---
// Molecule — landscape YouTube embed card for portfolio grid
interface Props {
  videoId?: string
  localSrc?: string
  title: string
  client?: string
  category?: string
}

const { videoId, localSrc, title, client, category } = Astro.props
const embedUrl = videoId
  ? `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1&color=white`
  : undefined
---

<article class="group relative rounded-2xl border border-white/8 bg-white/3 backdrop-blur-sm overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:border-red-500/25 hover:shadow-2xl hover:shadow-red-500/8">

  <!-- Top accent line -->
  <div aria-hidden="true" class="h-px w-full bg-linear-to-r from-transparent via-red-500/45 to-transparent"></div>

  <!-- 16:9 embed or local video -->
  <div class="relative aspect-video bg-black">
    {localSrc ? (
      <video
        title={title}
        controls
        preload="metadata"
        class="absolute inset-0 h-full w-full object-cover"
      >
        <source src={localSrc} type="video/mp4" />
      </video>
    ) : (
      <iframe
        src={embedUrl}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
        class="absolute inset-0 h-full w-full"
      ></iframe>
    )}
  </div>

  <!-- Footer bar -->
  <div class="flex items-center gap-3 border-t border-white/5 px-4 py-3">
    <svg class="h-4 w-4 shrink-0 text-red-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
    </svg>
    <div class="flex min-w-0 flex-col gap-0.5">
      <span class="truncate text-sm font-semibold text-white/80">{title}</span>
      {client && <span class="text-xs text-white/35">{client}</span>}
    </div>
    {category && (
      <span class="ms-auto shrink-0 rounded-full border border-white/8 bg-white/4 px-2.5 py-0.5 text-xs font-medium text-white/40">
        {category}
      </span>
    )}
  </div>

</article>
