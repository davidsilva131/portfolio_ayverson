---
// Molecule — vertical 9:16 embed card for Reels (TikTok / YouTube Shorts / Local)
interface Props {
  videoId?: string
  localSrc?: string
  title: string
  platform: 'tiktok' | 'youtube-shorts' | 'local'
  client?: string
}

const { videoId, localSrc, title, platform, client } = Astro.props

// TikTok embed uses their own embed URL; YouTube Shorts uses the standard embed
const embedUrl =
  platform === 'tiktok'
    ? `https://www.tiktok.com/embed/v2/${videoId}`
    : platform === 'youtube-shorts'
    ? `https://www.youtube.com/embed/${videoId}`
    : undefined

const labels: Record<string, string> = {
  tiktok:         'TikTok',
  'youtube-shorts': 'Reels',
  local:          'Local',
}
---

<article
  class="group relative rounded-2xl border border-white/8 bg-white/3 backdrop-blur-sm overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:border-violet-500/25 hover:shadow-2xl hover:shadow-violet-500/8"
>
  <!-- Violet accent line -->
  <div aria-hidden="true" class="h-px w-full bg-linear-to-r from-transparent via-violet-500/40 to-transparent"></div>

  <!-- 9:16 embed or local video -->
  <div class="relative aspect-9/16 bg-black">
    {localSrc ? (
      <video
        title={title}
        controls
        preload="metadata"
        class="absolute inset-0 h-full w-full object-cover"
      >
        <source src={localSrc} type="video/mp4" />
      </video>
    ) : (
      <iframe
        src={embedUrl}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
        class="absolute inset-0 h-full w-full"
      ></iframe>
    )}
  </div>

  <!-- Footer bar -->
  <div class="flex items-center gap-2 border-t border-white/5 px-3 py-2.5">
    {platform === 'tiktok' && (
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 shrink-0 text-white/60" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.66a8.27 8.27 0 004.84 1.55V6.76a4.85 4.85 0 01-1.07-.07z"/></svg>
    )}
    {platform === 'youtube-shorts' && (
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 shrink-0 text-white/60" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
    )}
    {platform === 'local' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 shrink-0 text-white/60" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
    )}
    <span class="text-xs font-semibold text-white/70">{labels[platform]}</span>
    <span class="text-white/20">·</span>
    <span class="truncate text-xs text-white/65">{title}</span>
    {client && <span class="ms-auto shrink-0 text-xs text-white/50">{client}</span>}
  </div>

</article>
