---
// Molecule — vertical 9:16 embed card for Reels (TikTok / YouTube Shorts / Local)
interface Props {
  videoId?: string
  localSrc?: string
  title: string
  platform: 'tiktok' | 'youtube-shorts' | 'local'
  client?: string
}

const { videoId, localSrc, title, platform, client } = Astro.props

// TikTok embed uses their own embed URL; YouTube Shorts uses the standard embed
const embedUrl =
  platform === 'tiktok'
    ? `https://www.tiktok.com/embed/v2/${videoId}`
    : platform === 'youtube-shorts'
    ? `https://www.youtube.com/embed/${videoId}`
    : undefined

const metaMap = {
  tiktok: {
    label:       'TikTok',
    accentClass: 'via-cyan-400/50',
    borderHover: 'hover:border-cyan-500/25',
    shadowHover: 'hover:shadow-cyan-500/8',
    dotColor:    'bg-cyan-400 shadow-[0_0_6px_#22d3ee]',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 text-cyan-400" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.66a8.27 8.27 0 004.84 1.55V6.76a4.85 4.85 0 01-1.07-.07z"/></svg>`,
  },
  'youtube-shorts': {
    label:       'Shorts',
    accentClass: 'via-red-500/50',
    borderHover: 'hover:border-red-500/25',
    shadowHover: 'hover:shadow-red-500/8',
    dotColor:    'bg-red-500 shadow-[0_0_6px_#ef4444]',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 text-red-400" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
  local: {
    label:       'Local',
    accentClass: 'via-violet-400/50',
    borderHover: 'hover:border-violet-500/25',
    shadowHover: 'hover:shadow-violet-500/8',
    dotColor:    'bg-violet-400 shadow-[0_0_6px_#a78bfa]',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 text-violet-400" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
  },
}
const meta = metaMap[platform]
---

<article
  class={`group relative rounded-2xl border border-white/8 bg-white/3 backdrop-blur-sm overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl ${meta.borderHover} ${meta.shadowHover}`}
>
  <!-- Platform accent line -->
  <div aria-hidden="true" class={`h-px w-full bg-linear-to-r from-transparent ${meta.accentClass} to-transparent`}></div>

  <!-- 9:16 embed or local video -->
  <div class="relative aspect-9/16 bg-black">
    {localSrc ? (
      <video
        src={localSrc}
        title={title}
        controls
        preload="metadata"
        class="absolute inset-0 h-full w-full object-cover"
      />
    ) : (
      <iframe
        src={embedUrl}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
        class="absolute inset-0 h-full w-full"
      ></iframe>
    )}
  </div>

  <!-- Footer bar -->
  <div class="flex items-center gap-2 border-t border-white/5 px-3 py-2.5">
    <span class={`h-1.5 w-1.5 shrink-0 rounded-full ${meta.dotColor}`}></span>
    <span class="text-xs font-bold text-white/60">{meta.label}</span>
    <span class="text-white/15">·</span>
    <span class="truncate text-xs text-white/50">{title}</span>
    {client && <span class="ms-auto shrink-0 text-xs text-white/25">{client}</span>}
  </div>

</article>
