---
// Molecule — creator client card with avatar, platform badge, and banner artwork
import PlatformBadge from "../atoms/PlatformBadge.astro"

interface Props {
  name: string
  platform: 'tiktok' | 'twitch' | 'youtube'
  subscribers: string
  avatar: string
  banner: string
}

const { name, platform, subscribers, avatar, banner } = Astro.props

const platformStyle: Record<string, {
  topAccent: string
  hoverBorder: string
  hoverShadow: string
  bannerBg: string
  avatarRingHover: string
}> = {
  tiktok: {
    topAccent:      'via-cyan-500/60',
    hoverBorder:    'hover:border-cyan-500/35',
    hoverShadow:    'hover:shadow-cyan-500/15',
    bannerBg:       'from-cyan-950 via-neutral-950 to-black',
    avatarRingHover:'group-hover:ring-cyan-500/40',
  },
  twitch: {
    topAccent:      'via-purple-500/60',
    hoverBorder:    'hover:border-purple-500/35',
    hoverShadow:    'hover:shadow-purple-500/15',
    bannerBg:       'from-purple-950 via-neutral-950 to-black',
    avatarRingHover:'group-hover:ring-purple-500/40',
  },
  youtube: {
    topAccent:      'via-red-500/60',
    hoverBorder:    'hover:border-red-500/35',
    hoverShadow:    'hover:shadow-red-500/15',
    bannerBg:       'from-red-950 via-neutral-950 to-black',
    avatarRingHover:'group-hover:ring-red-500/40',
  },
}

const s = platformStyle[platform]
---

<article
  class={`group relative flex flex-col rounded-2xl border border-white/8 bg-white/3 backdrop-blur-sm overflow-hidden transition-all duration-300 hover:-translate-y-2 hover:bg-white/5 hover:shadow-2xl ${s.hoverBorder} ${s.hoverShadow}`}
>
  <!-- Platform-colored top accent line -->
  <div
    aria-hidden="true"
    class={`h-px w-full bg-gradient-to-r from-transparent ${s.topAccent} to-transparent`}
  ></div>

  <!-- Card header: avatar + name + platform badge -->
  <div class="flex items-center gap-3 px-4 py-3.5">
    <div class="relative shrink-0">
      <img
        src={avatar}
        alt={`${name} avatar`}
        width="44"
        height="44"
        class={`h-11 w-11 rounded-full object-cover ring-2 ring-white/10 transition-all duration-300 ${s.avatarRingHover}`}
      />
    </div>
    <div class="flex min-w-0 flex-col gap-0.5">
      <span class="truncate text-[15px] font-bold leading-tight text-white">{name}</span>
      <PlatformBadge platform={platform} subscribers={subscribers} />
    </div>
  </div>

  <!-- Banner artwork with gradient fallback -->
  <div class={`relative mx-3 mb-3 aspect-[16/7] overflow-hidden rounded-xl bg-gradient-to-br ${s.bannerBg}`}>
    <!-- Fallback text shown when image is absent -->
    <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
      <span class="select-none text-3xl font-black uppercase tracking-widest text-white/5">
        {name}
      </span>
    </div>
    <img
      src={banner}
      alt={`Arte de ${name}`}
      class="absolute inset-0 z-10 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
  </div>
</article>
