---
// Molecule — creator client card with avatar, platform badge, and banner artwork
import PlatformBadge from "../atoms/PlatformBadge.astro"

interface Props {
  name: string
  platform: 'tiktok' | 'twitch' | 'youtube'
  subscribers: string
  avatar: string
  banner: string
}

const { name, platform, subscribers, avatar, banner } = Astro.props
---

<article
  class="group relative flex flex-col rounded-2xl border border-white/8 bg-white/3 backdrop-blur-sm overflow-hidden transition-all duration-300 hover:-translate-y-2 hover:bg-white/5 hover:border-violet-500/30 hover:shadow-2xl hover:shadow-violet-500/10"
>
  <!-- Violet accent line -->
  <div
    aria-hidden="true"
    class="h-px w-full bg-gradient-to-r from-transparent via-violet-500/50 to-transparent"
  ></div>

  <!-- Card header: avatar + name + platform badge -->
  <div class="flex items-center gap-3 px-4 py-3.5">
    <div class="relative shrink-0">
      <img
        src={avatar}
        alt={`${name} avatar`}
        width="44"
        height="44"
        class="h-11 w-11 rounded-full object-cover ring-2 ring-white/10 transition-all duration-300 group-hover:ring-violet-500/40"
      />
    </div>
    <div class="flex min-w-0 flex-col gap-0.5">
      <span class="truncate text-[15px] font-bold leading-tight text-white">{name}</span>
      <PlatformBadge platform={platform} subscribers={subscribers} />
    </div>
  </div>

  <!-- Banner artwork with gradient fallback -->
  <div class="relative mx-3 mb-3 aspect-[16/7] overflow-hidden rounded-xl bg-gradient-to-br from-violet-950 via-neutral-950 to-black">
    <!-- Fallback text shown when image is absent -->
    <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
      <span class="select-none text-3xl font-black uppercase tracking-widest text-white/5">
        {name}
      </span>
    </div>
    <img
      src={banner}
      alt={`Arte de ${name}`}
      class="absolute inset-0 z-10 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
  </div>
</article>
