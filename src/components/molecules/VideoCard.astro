---
// Molecule — featured YouTube video card with glassmorphism and tinted shadow
import Badge from "../atoms/Badge.astro"

interface Props {
  videoId: string
  title?: string
}

const { videoId, title = "Video destacado" } = Astro.props
const embedUrl = `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1&color=white`
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`
---

<div class="relative">
  <!-- Glass card with soft violet-tinted shadow -->
  <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/4 shadow-[0_24px_60px_-24px_rgba(139,92,246,0.4)] backdrop-blur-sm">

    <!-- Top bar -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-white/5">
      <Badge label="DESTACADO" size="sm" dataI18n="videocard.featured" />
    </div>

    <!-- Video embed -->
    <div class="relative aspect-video bg-black">
      <iframe
        src={embedUrl}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
        class="absolute inset-0 h-full w-full"
      ></iframe>
    </div>

    <!-- Bottom bar -->
    <div class="flex items-center gap-2 px-4 py-3 border-t border-white/5">
      <!-- YouTube logo SVG -->
      <svg class="h-4 w-auto text-red-500" viewBox="0 0 90 20" fill="currentColor" aria-hidden="true">
        <path d="M27.97 3.68a3.27 3.27 0 0 0-2.3-2.31C23.56.8 14.75.8 14.75.8s-8.8 0-10.92.57A3.27 3.27 0 0 0 1.53 3.68C.97 5.8.97 10.2.97 10.2s0 4.4.56 6.52a3.27 3.27 0 0 0 2.3 2.3c2.12.57 10.92.57 10.92.57s8.81 0 10.92-.57a3.27 3.27 0 0 0 2.3-2.3c.57-2.12.57-6.52.57-6.52s0-4.4-.57-6.52zM11.75 14.08V6.32l7.3 3.88-7.3 3.88z"/>
      </svg>
      <a
        href={watchUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-medium tracking-wide text-white/60 transition-colors duration-200 hover:text-white"
        data-i18n="videocard.mirar"
      >
        Mirar en YouTube
      </a>
    </div>
  </div>
</div>
