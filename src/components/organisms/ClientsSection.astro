---
// Organism — "Clientes" section: left-aligned header + 3-column grid of creator client cards
import ClientCard from "../molecules/ClientCard.astro"

const clients = [
  {
    name:        'Botti',
    platform:    'tiktok'  as const,
    subscribers: '2.2k',
    avatar:      '/creators/botti_logo.avif',
    banner:      '/creators/botti_banner.avif',
  },
  {
    name:        'JustVisa',
    platform:    'twitch'  as const,
    subscribers: '221k',
    avatar:      '/creators/justvisa_logo.avif',
    banner:      '/creators/justvisa_banner.avif',
  },
  {
    name:        'iSBreath',
    platform:    'tiktok'  as const,
    subscribers: '1.2k',
    avatar:      '/creators/badbunny_logo.avif',
    banner:      '/creators/badbunny_banner.avif',
  },
]
---

<section id="clientes" class="relative z-10 overflow-hidden py-28">

  <div class="relative mx-auto w-full max-w-6xl px-5">

    <!-- ── Section header (centered) ── -->
    <div class="reveal mb-16 flex flex-col items-center gap-4 text-center">
      <h2 class="text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl">
        <span class="text-white" data-i18n="clients.title_creadores">Creadores que </span>
        <span class="text-violet-400" data-i18n="clients.title_confian">confían</span>
        <span class="text-white" data-i18n="clients.title_en_mi"> en mí</span>
      </h2>
      <p class="max-w-md text-sm text-white/60 sm:text-base" data-i18n="clients.subtitle">
        Algunos de los creadores para quienes he editado contenido de alto impacto.
      </p>
    </div>

    <!-- ── Client card grid ── -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {clients.map((client, i) => (
        <div class="reveal" data-reveal-delay={i * 80}>
          <ClientCard
            name={client.name}
            platform={client.platform}
            subscribers={client.subscribers}
            avatar={client.avatar}
            banner={client.banner}
          />
        </div>
      ))}
    </div>

  </div>
</section>
