---
// Organism — full responsive navbar with glassmorphism and mobile drawer
import Logo from "../atoms/Logo.astro"
import NavLink from "../atoms/NavLink.astro"
import LangToggle from "../atoms/LangToggle.astro"

const links = [
  { href: "#inicio",    label: "Inicio",    i18n: "nav.inicio" },
  { href: "#clientes",  label: "Clientes",  i18n: "nav.clientes" },
  { href: "#videos",    label: "Videos",    i18n: "nav.videos" },
  { href: "#contacto",  label: "Contacto",  i18n: "nav.contacto" },
]
---

<header
  class="fixed top-0 inset-x-0 z-50 border-b border-white/5 bg-black/40 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4"
    aria-label="Navegación principal"
  >
    <!-- Logo -->
    <Logo />

    <!-- Desktop links (hidden on mobile) -->
    <ul class="hidden lg:flex items-center gap-8" role="list">
      {links.map(({ href, label, i18n }) => (
        <li>
          <NavLink href={href} label={label} dataI18n={i18n} />
        </li>
      ))}
    </ul>

    <!-- Desktop CTA + LangToggle -->
    <div class="hidden lg:flex items-center gap-3">
      <LangToggle />
      <button
        type="button"
        data-open-contact-modal
        data-i18n="nav.contactame"
        class="relative inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-violet-500/60 bg-violet-600/10 px-5 py-2 text-sm font-semibold tracking-wide text-violet-300 transition-all duration-300 hover:bg-violet-500/25 hover:text-white hover:border-violet-400"
      >
        Contáctame
      </button>
    </div>

    <!-- Mobile hamburger button -->
    <button
      id="nav-toggle"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-i18n-aria="nav.abrir-menu"
      aria-label="Abrir menú"
      class="lg:hidden flex cursor-pointer flex-col gap-1.5 p-2 group"
    >
      <span
        id="bar1"
        class="block h-0.5 w-6 rounded-full bg-white/70 origin-center transition-all duration-300"
      ></span>
      <span
        id="bar2"
        class="block h-0.5 w-6 rounded-full bg-white/70 transition-all duration-300"
      ></span>
      <span
        id="bar3"
        class="block h-0.5 w-6 rounded-full bg-white/70 origin-center transition-all duration-300"
      ></span>
    </button>
  </nav>

  <!-- Mobile menu drawer -->
  <div
    id="mobile-menu"
    class="overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out lg:hidden"
    aria-hidden="true"
  >
    <ul
      class="flex flex-col gap-1 px-5 pb-6 pt-2 border-t border-white/5"
      role="list"
    >
      {links.map(({ href, label, i18n }) => (
        <li>
          <a
            href={href}
            data-i18n={i18n}
            class="mobile-link block py-3 text-sm font-medium tracking-widest uppercase text-white/70 transition-colors duration-200 hover:text-white border-b border-white/5"
          >
            {label}
          </a>
        </li>
      ))}
      <li class="mt-4 flex items-center gap-3">
        <LangToggle />
        <button
          type="button"
          data-open-contact-modal
          data-i18n="nav.contactame"
          class="mobile-link flex-1 flex cursor-pointer items-center justify-center rounded-full border border-violet-500/60 bg-violet-600/10 px-5 py-3 text-sm font-semibold tracking-wide text-violet-300 transition-all duration-300 hover:bg-violet-500/25 hover:text-white"
        >
          Contáctame
        </button>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle")!
  const menu   = document.getElementById("mobile-menu")!
  const bar1   = document.getElementById("bar1")!
  const bar2   = document.getElementById("bar2")!
  const bar3   = document.getElementById("bar3")!

  let open = false

  toggle.addEventListener("click", () => {
    open = !open
    toggle.setAttribute("aria-expanded", String(open))
    menu.setAttribute("aria-hidden", String(!open))

    // Animate drawer
    menu.style.maxHeight = open ? menu.scrollHeight + "px" : "0px"

    // Animate hamburger → X
    if (open) {
      bar1.style.transform = "translateY(8px) rotate(45deg)"
      bar2.style.opacity = "0"
      bar3.style.transform = "translateY(-8px) rotate(-45deg)"
    } else {
      bar1.style.transform = ""
      bar2.style.opacity = "1"
      bar3.style.transform = ""
    }
  })

  // Close menu when a mobile link is tapped
  menu.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => {
      open = false
      toggle.setAttribute("aria-expanded", "false")
      menu.setAttribute("aria-hidden", "true")
      menu.style.maxHeight = "0px"
      bar1.style.transform = ""
      bar2.style.opacity = "1"
      bar3.style.transform = ""
    })
  })
</script>
