---
// Organism — "Sobre Mí" section: bio text + platform/stats visual panel
import Badge from "../atoms/Badge.astro"
---

<section id="sobre-mi" class="relative z-10 overflow-hidden py-28">

  <!-- Ambient glows -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-40 top-1/3 h-xl w-xl rounded-full bg-violet-700/15 blur-[130px]"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-20 bottom-0 h-120 w-120 rounded-full bg-cyan-700/12 blur-[110px]"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-0 h-64 w-64 -translate-x-1/2 rounded-full bg-fuchsia-800/10 blur-[90px]"
  ></div>

  <!-- Dot grid -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,rgba(255,255,255,0.045)_1px,transparent_1px)] bg-size-[30px_30px]"
  ></div>

  <div class="relative mx-auto w-full max-w-6xl px-5">

    <!-- ── Section header ── -->
    <div class="mb-16 flex flex-col items-center gap-4 text-center">
      <Badge label="Sobre Mí" dot="violet" />
      <h2 class="text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl">
        <span class="text-white">El </span>
        <span class="bg-linear-to-r from-violet-400 via-fuchsia-400 to-cyan-400 bg-clip-text text-transparent">editor</span>
        <span class="text-white"> detrás del contenido</span>
      </h2>
      <p class="max-w-md text-sm text-white/35 sm:text-base">
        Conoce quién se encarga de llevar tus ideas a la pantalla.
      </p>
    </div>

    <!-- ── Two-column layout ── -->
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">

      <!-- ── LEFT: Bio paragraphs ── -->
      <div class="flex h-full flex-col gap-5">

        <!-- Para 1 — Presentación (violet accent) -->
        <div class="group relative flex flex-1 flex-col justify-center rounded-2xl border border-white/6 bg-white/3 p-6 backdrop-blur-sm transition-all duration-300 hover:border-violet-500/25 hover:bg-violet-500/5">
          <div class="absolute left-0 top-4 bottom-4 w-0.5 rounded-full bg-linear-to-b from-violet-500 to-violet-400/30"></div>
          <p class="ps-1 text-base leading-relaxed text-white/65 sm:text-[1.05rem]">
            ¡Hola! mi nombre es
            <span class="font-bold bg-linear-to-r from-violet-400 to-violet-300 bg-clip-text text-transparent"> Ayverson</span>,
            soy un
            <strong class="font-bold text-white"> editor de videos</strong>
            especializado en el contenido vertical para
            <strong class="font-bold text-white"> Shorts</strong>,
            <span class="font-bold bg-linear-to-r from-fuchsia-400 to-pink-400 bg-clip-text text-transparent"> Reels</span>
            y
            <span class="font-bold bg-linear-to-r from-cyan-400 to-teal-400 bg-clip-text text-transparent"> TikTok</span>.
          </p>
        </div>

        <!-- Para 2 — Estrategia (cyan accent) -->
        <div class="group relative flex flex-1 flex-col justify-center rounded-2xl border border-white/6 bg-white/3 p-6 backdrop-blur-sm transition-all duration-300 hover:border-cyan-500/25 hover:bg-cyan-500/5">
          <div class="absolute left-0 top-4 bottom-4 w-0.5 rounded-full bg-linear-to-b from-cyan-500 to-cyan-400/30"></div>
          <p class="ps-1 text-base leading-relaxed text-white/65 sm:text-[1.05rem]">
            Lo rápido y lo vertical están dominando las redes sociales y los videos cortos son la mejor estrategia para atraer público a tu
            <strong class="font-bold text-white"> contenido principal</strong>,
            ya bien sea a streams o videos horizontales.
          </p>
        </div>

        <!-- Para 3 — Especialización (emerald accent) -->
        <div class="group relative flex flex-1 flex-col justify-center rounded-2xl border border-white/6 bg-white/3 p-6 backdrop-blur-sm transition-all duration-300 hover:border-emerald-500/25 hover:bg-emerald-500/5">
          <div class="absolute left-0 top-4 bottom-4 w-0.5 rounded-full bg-linear-to-b from-emerald-500 to-emerald-400/30"></div>
          <p class="ps-1 text-base leading-relaxed text-white/65 sm:text-[1.05rem]">
            Me especializo en
            <span class="font-bold bg-linear-to-r from-emerald-400 to-teal-400 bg-clip-text text-transparent"> ediciones impactantes</span>,
            con cortes precisos y efectos llamativos que puedan retener al espectador desde el primer segundo.
          </p>
        </div>

        <!-- Para 4 — Gaming (red accent) -->
        <div class="group relative flex flex-1 flex-col justify-center rounded-2xl border border-white/6 bg-white/3 p-6 backdrop-blur-sm transition-all duration-300 hover:border-red-500/25 hover:bg-red-500/5">
          <div class="absolute left-0 top-4 bottom-4 w-0.5 rounded-full bg-linear-to-b from-red-500 to-red-400/30"></div>
          <p class="ps-1 text-base leading-relaxed text-white/65 sm:text-[1.05rem]">
            Aunque mi mayor experiencia es el contenido
            <span class="font-bold bg-linear-to-r from-red-400 to-orange-400 bg-clip-text text-transparent"> Gaming</span>,
            específicamente
            <span class="font-bold bg-linear-to-r from-red-500 to-yellow-400 bg-clip-text text-transparent"> Valorant</span>,
            me puedo adaptar a cualquier tipo de contenido.
          </p>
        </div>

      </div>

      <!-- ── RIGHT: Visual panel ── -->
      <div class="flex flex-col gap-5">

        <!-- Profile initial card with rotating glow ring -->
        <div class="relative overflow-hidden rounded-2xl border border-violet-500/20 bg-linear-to-br from-violet-900/30 via-indigo-900/20 to-transparent p-8 text-center">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(139,92,246,0.15),transparent_70%)]"
          ></div>

          <!-- Avatar ring -->
          <div class="relative mx-auto mb-5 flex h-24 w-24 items-center justify-center">
            <!-- Glow behind -->
            <div
              aria-hidden="true"
              class="absolute inset-0 rounded-full bg-violet-500/30 blur-[20px]"
            ></div>
            <!-- Ring border -->
            <div class="absolute inset-0 rounded-full border-2 border-violet-400/50 shadow-[0_0_24px_rgba(139,92,246,0.4)]"></div>
            <!-- Inner background -->
            <div class="relative flex h-full w-full items-center justify-center rounded-full bg-linear-to-br from-violet-600/40 to-indigo-700/40">
              <img src="/creators/logo_ayvershit.avif" alt="Ayverson logo" class="h-full w-full rounded-full object-cover" />
            </div>
          </div>

          <p class="text-lg font-bold text-white">Ayverson</p>
          <p class="mt-1 text-sm text-white/45">Editor · Diseñador · Animador</p>

          <!-- Divider -->
          <div class="my-5 h-px w-full bg-linear-to-r from-transparent via-white/10 to-transparent"></div>

          <!-- Tiny skill tags -->
          <div class="flex flex-wrap justify-center gap-2">
            <span class="rounded-full border border-violet-500/25 bg-violet-500/10 px-3 py-1 text-xs font-semibold text-violet-300">Editor de Videos</span>
            <span class="rounded-full border border-cyan-500/25 bg-cyan-500/10 px-3 py-1 text-xs font-semibold text-cyan-300">Diseñador Gráfico</span>
            <span class="rounded-full border border-fuchsia-500/25 bg-fuchsia-500/10 px-3 py-1 text-xs font-semibold text-fuchsia-300">Animador</span>
          </div>
        </div>

        <!-- Platforms card -->
        <div class="rounded-2xl border border-white/8 bg-white/3 p-6">
          <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-white/35">Herramientas</h3>
          <div class="flex flex-col gap-2.5">

            <!-- Adobe Premiere -->
            <div class="flex items-center gap-3 rounded-xl border border-violet-500/20 bg-violet-500/8 px-4 py-3 transition-all duration-200 hover:border-violet-500/35 hover:bg-violet-500/12">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-violet-500 shadow-[0_0_8px_rgba(139,92,246,0.8)]"></span>
              <span class="text-sm font-semibold text-white/80">Adobe Premiere</span>
              <span class="ms-auto text-xs text-white/25">edición</span>
            </div>

            <!-- After Effects -->
            <div class="flex items-center gap-3 rounded-xl border border-indigo-500/20 bg-indigo-500/8 px-4 py-3 transition-all duration-200 hover:border-indigo-500/35 hover:bg-indigo-500/12">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-indigo-400 shadow-[0_0_8px_rgba(99,102,241,0.8)]"></span>
              <span class="text-sm font-semibold text-white/80">After Effects</span>
              <span class="ms-auto text-xs text-white/25">animación</span>
            </div>

            <!-- Photoshop -->
            <div class="flex items-center gap-3 rounded-xl border border-cyan-500/20 bg-cyan-500/8 px-4 py-3 transition-all duration-200 hover:border-cyan-500/35 hover:bg-cyan-500/12">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.8)]"></span>
              <span class="text-sm font-semibold text-white/80">Photoshop</span>
              <span class="ms-auto text-xs text-white/25">diseño</span>
            </div>

            <!-- Illustrator -->
            <div class="flex items-center gap-3 rounded-xl border border-orange-500/20 bg-orange-500/8 px-4 py-3 transition-all duration-200 hover:border-orange-500/35 hover:bg-orange-500/12">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-orange-400 shadow-[0_0_8px_rgba(251,146,60,0.8)]"></span>
              <span class="text-sm font-semibold text-white/80">Illustrator</span>
              <span class="ms-auto text-xs text-white/25">vectores</span>
            </div>

          </div>
        </div>

        <!-- Specialty card -->
        <div class="relative overflow-hidden rounded-2xl border border-violet-500/20 bg-linear-to-br from-violet-900/20 to-indigo-900/10 p-6">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -right-6 -top-6 h-32 w-32 rounded-full bg-violet-600/20 blur-[50px]"
          ></div>
          <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-white/35">Especialidades</h3>
          <div class="flex flex-col gap-3">

            <!-- Gaming -->
            <div class="flex items-center gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-red-500/25 bg-red-500/15">
                <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17 4H7C3.79 4 1 6.79 1 10v2c0 3.21 2.79 6 6 6h10c3.21 0 6-2.79 6-6v-2c0-3.21-2.79-6-6-6zM8 13H7v1H6v-1H5v-1h1V10h1v2h1v1zm7 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2-3c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-white">Gaming</p>
                <p class="text-xs text-white/40">Valorant y más</p>
              </div>
            </div>

            <!-- IRL -->
            <div class="flex items-center gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-emerald-500/25 bg-emerald-500/15">
                <svg class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-white">IRL</p>
                <p class="text-xs text-white/40">Vida real y vlogs</p>
              </div>
            </div>

            <!-- Blogs -->
            <div class="flex items-center gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-cyan-500/25 bg-cyan-500/15">
                <svg class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-white">Blogs</p>
                <p class="text-xs text-white/40">Contenido informativo</p>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</section>
