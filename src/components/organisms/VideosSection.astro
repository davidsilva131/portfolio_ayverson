---
// Organism — Videos section: tabbed portfolio grid (YouTube landscape + Reels/Shorts vertical)
import Badge from "../atoms/Badge.astro"
import YoutubeVideoCard from "../molecules/YoutubeVideoCard.astro"
import ReelCard from "../molecules/ReelCard.astro"

// ── Video data — use videoId for YouTube/TikTok or localSrc for files in public/videos/ ──
const youtubeVideos = [
  { videoId: 'JroZMa8zbcc',  title: 'SI PARPADEO EN LA VIDA REAL, ¡MUERO!',     client: 'Botti',    category: 'Gaming' },
  { videoId: '--1KlgRCRqI',  title: 'En esta partida sacaron lo peor de mi — JustVisa', client: 'JustVisa', category: 'Gaming' },
  // Local examples — uncomment and set the correct filename:
  // { localSrc: '/videos/BA BA BAD JUSTVISA.mp4',          title: 'BA BA BAD',             client: 'JustVisa', category: 'Edit'   },
  // { localSrc: '/videos/JaviHero.mp4',                    title: 'JaviHero',              client: 'Personal', category: 'Edit'   },
  // { localSrc: '/videos/JustVisa Video Auto-tune.mp4',    title: 'Auto-tune Edit',        client: 'JustVisa', category: 'Edit'   },
  // { localSrc: '/videos/KRÜ.mp4',                         title: 'KRÜ',                   client: 'KRÜ',      category: 'Edit'   },
  // { localSrc: '/videos/que mas quieren de miiiii.mp4',   title: 'Que Más Quieren',       client: 'Personal', category: 'Edit'   },
  // { localSrc: '/videos/Sbreath.mp4',                     title: 'Sbreath',               client: 'Sbreath',  category: 'Edit'   },
  // { localSrc: '/videos/TIMING PERFECTO.mp4',             title: 'Timing Perfecto',       client: 'Personal', category: 'Edit'   },
  // { localSrc: '/videos/Unitiled 1.mp4',                  title: 'Untitled 1',            client: 'Personal', category: 'Edit'   },
]

const reels = [
  { localSrc: 'https://res.cloudinary.com/dwh6yph1x/video/upload/v1774545486/portfolio/TIMING%20PERFECTO.mp4', title: 'Gameplay', platform: 'local' as const, client: 'Personal' },
  { localSrc: 'https://res.cloudinary.com/dwh6yph1x/video/upload/v1774544843/portfolio/JaviHero.mp4', title: 'Valorant Gameplay', platform: 'local' as const, client: 'Personal' },
  { localSrc: 'https://res.cloudinary.com/dwh6yph1x/video/upload/v1774545424/portfolio/que%20mas%20quieren%20de%20miiiii.mp4', title: 'Valorant Gameplay', platform: 'local' as const, client: 'Personal' },
  { localSrc: 'https://res.cloudinary.com/dwh6yph1x/video/upload/v1774545371/portfolio/JustVisa%20Video%20Auto-tune.mp4', title: 'Just Chatting', platform: 'local' as const, client: 'Personal' },
  { localSrc: 'https://res.cloudinary.com/dwh6yph1x/video/upload/v1774545251/portfolio/BA%20BA%20BAD%20JUSTVISA.mp4', title: 'Just Chatting', platform: 'local' as const, client: 'Personal' },
  { localSrc: 'https://res.cloudinary.com/dwh6yph1x/video/upload/v1774544849/portfolio/KR%C3%9C.mp4', title: 'Informativo', platform: 'local' as const, client: 'Personal' },
  { localSrc: 'https://res.cloudinary.com/dwh6yph1x/video/upload/v1774544857/portfolio/Sbreath.mp4', title: 'Gameplay', platform: 'local' as const, client: 'Personal' },
  { localSrc: 'https://res.cloudinary.com/dwh6yph1x/video/upload/v1774545535/portfolio/Unitiled1.mp4', title: 'Gameplay', platform: 'local' as const, client: 'Personal' },



  // { localSrc: '/videos/TIMING PERFECTO.mp4',           title: 'Timing Perfecto', platform: 'local' as const, client: 'Personal' },
]
---

<section id="videos" class="relative z-10 overflow-hidden py-28">

  <!-- Ambient glows -->
  <div aria-hidden="true" class="pointer-events-none absolute -left-40 top-1/3 h-125 w-125 rounded-full bg-violet-700/12 blur-[140px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -right-24 bottom-1/4 h-110 w-110 rounded-full bg-cyan-700/10 blur-[120px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-0 h-64 w-64 -translate-x-1/2 rounded-full bg-rose-800/8 blur-[90px]"></div>

  <!-- Dot grid texture -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-size-[30px_30px]"></div>

  <div class="relative mx-auto w-full max-w-6xl px-5">

    <!-- ── Section header ── -->
    <div class="mb-12 flex flex-col items-center gap-4 text-center">
      <Badge label="Portafolio" dot="violet" />
      <h2 class="text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl">
        <span class="text-white">Mi </span>
        <span class="bg-linear-to-r from-violet-400 via-fuchsia-400 to-rose-400 bg-clip-text text-transparent">trabajo</span>
        <span class="text-white"> en acción</span>
      </h2>
      <p class="max-w-md text-sm text-white/35 sm:text-base">
        Desde montajes cinematográficos hasta reels con ganchos impactantes.
        Cada frame editado con intención.
      </p>
    </div>

    <!-- ── Tab switcher ── -->
    <div class="mb-10 flex justify-center">
      <div class="flex gap-1 rounded-full border border-white/10 bg-white/5 p-1 backdrop-blur-sm">

        <button
          data-tab="reels"
          data-active="true"
          class="flex items-center gap-2 rounded-full px-6 py-2.5 text-sm font-semibold transition-all duration-200
                 text-white/45 hover:text-white/70
                 data-[active=true]:bg-white/8 data-[active=true]:text-white data-[active=true]:border data-[active=true]:border-white/12 data-[active=true]:shadow-sm"
        >
          <svg class="h-3.5 w-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="7" y="2" width="10" height="20" rx="2"/>
            <line x1="12" y1="18" x2="12.01" y2="18"/>
          </svg>
          Reels & Shorts
        </button>

        <button
          data-tab="youtube"
          class="flex items-center gap-2 rounded-full px-6 py-2.5 text-sm font-semibold transition-all duration-200
                 text-white/45 hover:text-white/70
                 data-[active=true]:bg-white/8 data-[active=true]:text-white data-[active=true]:border data-[active=true]:border-white/12 data-[active=true]:shadow-sm"
        >
          <svg class="h-3.5 w-3.5 text-red-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          YouTube
        </button>

      </div>
    </div>

    <!-- ── YouTube panel ── -->
    <div id="panel-youtube" data-panel="youtube" class="hidden">
      <div class="grid gap-5 sm:grid-cols-2">
        {youtubeVideos.map(v => (
          <YoutubeVideoCard
            videoId={(v as any).videoId}
            localSrc={(v as any).localSrc}
            title={v.title}
            client={v.client}
            category={v.category}
          />
        ))}
      </div>
    </div>

    <!-- ── Reels panel ── -->
    <div id="panel-reels" data-panel="reels">
      <div class="flex flex-wrap justify-center gap-4 [&>*]:w-[calc(50%-0.5rem)] sm:[&>*]:w-[calc(33.333%-0.89rem)]">
        {reels.map(r => (
          <ReelCard
            videoId={(r as any).videoId}
            localSrc={(r as any).localSrc}
            title={r.title}
            platform={r.platform}
            client={r.client}
          />
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-tab]')
  const panels     = document.querySelectorAll<HTMLElement>('[data-panel]')

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = (btn as HTMLButtonElement).dataset.tab!

      // Toggle active state on tabs via data attribute
      tabButtons.forEach(b => {
        if (b === btn) {
          b.dataset.active = 'true'
        } else {
          delete b.dataset.active
        }
      })

      // Show/hide panels
      panels.forEach(p => {
        p.classList.toggle('hidden', p.dataset.panel !== target)
      })
    })
  })
</script>
