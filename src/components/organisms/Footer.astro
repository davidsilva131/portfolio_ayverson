---
// Organism — site footer with nav links, social icons, and copyright
import Logo from "../atoms/Logo.astro"

const links = [
  { href: "#inicio",    label: "Inicio" },
  { href: "#sobre-mi",  label: "Sobre mí" },
  { href: "#clientes",  label: "Clientes" },
  { href: "#videos",    label: "Videos" },
  { href: "#preguntas", label: "Preguntas" },
]

const socials = [
  {
    label: "Instagram",
    href: "https://instagram.com",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>`,
  },
  {
    label: "Twitter / X",
    href: "https://x.com",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
]
---

<footer class="relative z-10 mt-24 border-t border-white/5 bg-black/40 backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-5 py-12">

    <!-- Top row: logo + nav links -->
    <div class="flex flex-col items-center gap-8 sm:flex-row sm:justify-between">
      <Logo />

      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2" role="list">
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-sm text-white/50 transition-colors duration-200 hover:text-violet-300"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Divider -->
    <div class="my-8 h-px w-full bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

    <!-- Bottom row: copyright + socials -->
    <div class="flex flex-col items-center gap-6 sm:flex-row sm:justify-between">
      <p class="text-xs text-white/30">
        © {new Date().getFullYear()} Ayverson. Todos los derechos reservados.
      </p>

      <!-- Social icons -->
      <ul class="flex items-center gap-4" role="list" aria-label="Redes sociales">
        {socials.map(({ href, label, icon }) => (
          <li>
            <a
              href={href}
              aria-label={label}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center text-white/40 transition-all duration-200 hover:text-violet-300 hover:drop-shadow-[0_0_8px_rgba(139,92,246,0.7)]"
              set:html={icon}
            />
          </li>
        ))}
      </ul>
    </div>

  </div>
</footer>
