---
// Organism — full hero section: gradient headline + featured video card
import Badge from "../atoms/Badge.astro"
import VideoCard from "../molecules/VideoCard.astro"

interface Props {
  videoId?: string
}

const { videoId = "de12qz_ZDSg" } = Astro.props
---

<section
  id="inicio"
  class="relative flex min-h-screen items-center overflow-hidden py-28"
>

  <!-- Dots grid texture -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,rgba(255,255,255,0.055)_1px,transparent_1px)] bg-size-[30px_30px]"
  ></div>

  <!-- Left ambient glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-32 top-1/2 h-160 w-160 -translate-y-1/2 rounded-full bg-violet-800/20 blur-[120px]"
  ></div>

  <!-- Right ambient glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-32 top-1/4 h-125 w-125 rounded-full bg-indigo-700/15 blur-[100px]"
  ></div>

  <div class="relative mx-auto w-full max-w-6xl px-5">
    <div class="grid items-center gap-14 lg:grid-cols-[1fr_1.15fr] lg:gap-10">

      <!-- ── LEFT: Text content ── -->
      <div class="flex flex-col gap-7">

        <!-- Badge -->
        <div class="w-fit">
          <Badge label="Editor Profesional de Videos" dot="green" dataI18n="hero.badge" />
        </div>

        <!-- Headline -->
        <h1 class="text-lg font-black leading-[1.2] tracking-tight sm:text-2xl lg:text-[1.6rem] xl:text-[2rem] 2xl:text-[2.4rem]">
          <!-- Línea 1: Potencia tu contenido -->
          <span class="block">
            <span class="bg-linear-to-r from-violet-400 to-violet-300 bg-clip-text text-transparent" data-i18n="hero.line1_potencia">Potencia</span>
            <span class="text-white" data-i18n="hero.line1_tu"> tu </span>
            <span class="bg-linear-to-r from-cyan-400 to-cyan-300 bg-clip-text text-transparent" data-i18n="hero.line1_contenido">contenido</span>
          </span>
          <!-- Línea 2: con ediciones creativas y -->
          <span class="block">
            <span class="text-white" data-i18n="hero.line2_con">con </span>
            <span class="bg-linear-to-r from-indigo-400 via-violet-300 to-indigo-300 bg-clip-text text-transparent" data-i18n="hero.line2_ediciones">ediciones</span>
            <span class="text-white" data-i18n="hero.line2_creativas"> creativas, </span>
          </span>
          <!-- Línea 3: efectos y animaciones únicas -->
          <span class="block">
            <span class="bg-linear-to-r from-fuchsia-400 via-pink-400 to-rose-400 bg-clip-text text-transparent" data-i18n="hero.line3_efectos">efectos</span>
            <span class="text-white" data-i18n="hero.line3_y"> y </span>
            <span class="bg-linear-to-r from-emerald-400 to-teal-400 bg-clip-text text-transparent" data-i18n="hero.line3_animaciones">animaciones</span>
            <span class="text-white" data-i18n="hero.line3_unicas"> únicas</span>
          </span>
        </h1>

        <!-- Description -->
        <h2 class="max-w-110 text-base leading-relaxed text-white sm:text-lg">
          <span class="text-white font-bold" data-i18n="hero.cta_esperas"> ¿QUE ESPERAS?</span>
          <br>
          <span class="text-white" data-i18n="hero.cta_nivel">¡LLEVEMOS TU CONTENIDO AL SIGUIENTE NIVEL!</span>
        </h2>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4">
          <button
            type="button"
            data-open-contact-modal
            class="inline-flex items-center gap-2.5 rounded-full bg-linear-to-r from-emerald-500 to-teal-500 px-7 py-3.5 text-sm font-bold text-white shadow-[0_0_28px_rgba(16,185,129,0.45)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_40px_rgba(16,185,129,0.65)]"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span data-i18n="hero.btn_trabajemos">¡Trabajemos Juntos!</span>
          </button>

          <a
            href="#videos"
            class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white/70 backdrop-blur-sm transition-all duration-300 hover:border-white/30 hover:bg-white/10 hover:text-white"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" />
            </svg>
            <span data-i18n="hero.btn_ver_trabajo">Ver mi trabajo</span>
          </a>
        </div>

      </div>

      <!-- ── RIGHT: Video card ── -->
      <div class="flex justify-center lg:justify-end">
        <div class="w-full max-w-140">
          <VideoCard videoId={videoId} title="Video destacado por el editor" />
        </div>
      </div>

    </div>
  </div>

</section>
